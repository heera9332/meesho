# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:admin@127.0.0.1:5432/meesho_ecommerce

# Payload Secret
PAYLOAD_SECRET=meesho-payload-ecommerce-secret-key-32charsmin

# Server URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Meta & Brand
COMPANY_NAME="Meesho Ecommerce"
SITE_NAME="Meesho Store"

# Preview Drafts
PREVIEW_SECRET=meesho-draft-preview-secret

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=true
SMTP_FROM_ADDRESS=noreply@meesho.com
SMTP_FROM_NAME="Meesho Ecommerce"
